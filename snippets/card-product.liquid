<div class="gifty-card group flex flex-col h-full bg-white relative">
  <!-- Badge -->
  {%- if demo_badge != blank -%}
    <div class="absolute top-3 left-3 z-10">
      <span class="gifty-badge gifty-badge-dark">{{ demo_badge }}</span>
    </div>
  {%- endif -%}

  <!-- Image Container -->
  <a href="{{ product.url | default: '/products/demo-product' }}" class="aspect-square bg-gray-100 overflow-hidden block relative">
    <img src="{{ product.featured_image | image_url: width: 500 | default: demo_image | default: 'https://images.unsplash.com/photo-1611591475571-124b616b6c4b?w=600&auto=format&fit=crop&q=80' }}" alt="{{ product.title | default: demo_title }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
  </a>

  <!-- Content -->
  <div class="p-4 flex flex-col flex-1 justify-between">
    <div>
      <span class="text-xs text-gray-400 uppercase tracking-wider font-semibold">{{ product.vendor | default: "Gifty.in Exclusive" }}</span>
      <h3 class="font-serif font-bold text-base text-[#0C1626] mt-1 mb-2 line-clamp-2">
        <a href="{{ product.url | default: '/products/demo-product' }}" class="hover:text-[#D4B07B] transition">{{ product.title | default: demo_title | default: "Royal Kundan Bangles Set" }}</a>
      </h3>
    </div>

    <div>
      <div class="flex items-center space-x-2 mb-3">
        <span class="font-bold text-lg text-[#0C1626]">{{ product.price | money_or_fallback: demo_price | default: "₹1,499" }}</span>
        <span class="text-xs text-gray-400 line-through">{{ product.compare_at_price | money_or_fallback: demo_compare | default: "₹2,999" }}</span>
      </div>
      
      <a href="{{ product.url | default: '/products/demo-product' }}" class="w-full btn-primary text-xs py-2.5 block text-center">
        Quick View / Add
      </a>
    </div>
  </div>
</div>
