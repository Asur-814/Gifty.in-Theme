<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0C1626">
  <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {{ content_for_header }}

  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
</head>

<body class="bg-[#FBFBF9] text-[#1B1B1B] antialiased">
  <a class="skip-to-content-link button sr-only" href="#MainContent">
    Skip to content
  </a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <!-- WhatsApp Floating Widget -->
  <a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' }}" target="_blank" rel="noopener" style="position: fixed; bottom: 24px; right: 24px; z-index: 50; width: 56px; height: 56px; min-width: 56px; min-height: 56px; background-color: #25D366; color: #FFFFFF; border-radius: 9999px; box-shadow: 0 4px 20px rgba(0,0,0,0.2); display: flex; align-items: center; justify-content: center; text-decoration: none;" aria-label="Chat on WhatsApp">
    {% render 'icon-whatsapp' %}
  </a>
</body>
</html>
