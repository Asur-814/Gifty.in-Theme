<div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <h1 class="text-3xl font-serif font-bold text-[#0C1626] mb-8">Your Shopping Cart</h1>
  
  {%- if cart.item_count > 0 -%}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-4">
        {%- for item in cart.items -%}
          <div class="gifty-card p-4 flex items-center space-x-4">
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" class="w-20 h-20 object-cover rounded-lg">
            <div class="flex-1">
              <h3 class="font-serif font-bold text-base text-[#0C1626]">{{ item.product.title }}</h3>
              <p class="text-xs text-gray-500">{{ item.variant.title }}</p>
              <p class="text-sm font-bold text-[#0C1626] mt-1">{{ item.final_price | money }}</p>
            </div>
            <div class="flex items-center space-x-2 border border-gray-300 rounded-lg p-1">
              <span class="px-3 py-1 font-semibold text-sm">{{ item.quantity }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div>
        <div class="gifty-card p-6 space-y-4">
          <h3 class="font-serif font-bold text-lg text-[#0C1626] border-b border-[#E5E0D8] pb-3">Order Summary</h3>
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Subtotal</span>
            <span class="font-bold">{{ cart.total_price | money }}</span>
          </div>
          <p class="text-xs text-emerald-600 font-medium">✨ Free surprise luxury gift unlocked with prepaid order!</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="w-full btn-primary py-3.5 text-base">Proceed to Secure Checkout</button>
          </form>
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="text-center py-16 gifty-card p-12 max-w-xl mx-auto">
      <h2 class="text-2xl font-serif font-bold text-[#0C1626] mb-3">Your cart is empty</h2>
      <p class="text-gray-600 mb-6">Explore our viral gifting collection and find something special today.</p>
      <a href="{{ routes.root_url }}" class="btn-primary">Start Shopping</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart items",
  "settings": []
}
{% schema %}
