<footer class="bg-[#0C1626] text-[#F5F0EB] pt-16 pb-12 border-t border-[#D4B07B]/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
    <!-- Brand Column -->
    <div class="space-y-4">
      <h3 class="text-2xl font-serif font-bold text-[#D4B07B]">Gifty.in</h3>
      <p class="text-sm text-[#F5F0EB]/80 leading-relaxed">
        India's premier destination for handcrafted luxury gifts, stunning fashion accessories, and personalized hampers. Dispatch within 24 hours.
      </p>
      <div class="flex space-x-4 pt-2">
        <a href="https://instagram.com" target="_blank" class="text-[#D4B07B] hover:text-white transition">Instagram</a>
        <a href="https://facebook.com" target="_blank" class="text-[#D4B07B] hover:text-white transition">Facebook</a>
        <a href="https://whatsapp.com" target="_blank" class="text-[#D4B07B] hover:text-white transition">WhatsApp</a>
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h4 class="font-serif font-bold text-lg text-[#D4B07B] mb-4">Connect With Us</h4>
      <ul class="space-y-2.5 text-sm text-[#F5F0EB]/80">
        <li><a href="https://wa.me/917390802311" class="hover:text-[#D4B07B] transition">WhatsApp Support</a></li>
        <li><a href="/pages/contact" class="hover:text-[#D4B07B] transition">Contact Form</a></li>
        <li><a href="/collections/all" class="hover:text-[#D4B07B] transition">Instagram Shop</a></li>
      </ul>
    </div>

    <!-- Order Support -->
    <div>
      <h4 class="font-serif font-bold text-lg text-[#D4B07B] mb-4">Order Support</h4>
      <ul class="space-y-2.5 text-sm text-[#F5F0EB]/80">
        <li><a href="/pages/track-order" class="hover:text-[#D4B07B] transition">Track Your Order</a></li>
        <li><a href="/pages/returns" class="hover:text-[#D4B07B] transition">Return / Exchange Policy</a></li>
        <li><a href="/pages/shipping" class="hover:text-[#D4B07B] transition">Shipping Policy</a></li>
        <li><a href="/pages/terms" class="hover:text-[#D4B07B] transition">Terms of Service</a></li>
        <li><a href="/pages/faqs" class="hover:text-[#D4B07B] transition">FAQs</a></li>
      </ul>
    </div>

    <!-- Newsletter -->
    <div>
      <h4 class="font-serif font-bold text-lg text-[#D4B07B] mb-4">Join Gifty Club</h4>
      <p class="text-sm text-[#F5F0EB]/80 mb-4">Subscribe to receive exclusive festive discounts, secret voucher codes, and first access to new collections.</p>
      <form class="space-y-2">
        <input type="email" placeholder="Enter your email address" class="w-full px-4 py-3 rounded-full bg-[#172946] border border-[#D4B07B]/40 text-[#F5F0EB] placeholder-[#F5F0EB]/50 text-sm focus:outline-none focus:border-[#D4B07B]">
        <button type="submit" class="w-full btn-secondary py-3 text-sm">Subscribe & Get 10% Off</button>
      </form>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 border-t border-[#D4B07B]/20 text-center text-xs text-[#F5F0EB]/60">
    <p>&copy; {{ 'now' | date: '%Y' }} GIFTY.IN. ALL RIGHTS RESERVED. DESIGNED FOR LUXURY GIFTING ACROSS INDIA.</p>
  </div>
</footer>

