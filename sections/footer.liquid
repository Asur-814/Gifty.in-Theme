<footer class="gifty-footer">
  <div class="gifty-footer-grid">
    <!-- Brand Column -->
    <div class="space-y-4">
      <h3 style="font-family: var(--font-heading); color: #D4B07B; font-size: 24px; margin-bottom: 12px;">Gifty.in</h3>
      <p style="font-size: 14px; color: rgba(245,240,235,0.8); line-height: 1.6;">
        India's premier destination for handcrafted luxury gifts, stunning fashion accessories, and personalized hampers. Dispatch within 24 hours.
      </p>
      <div style="display: flex; gap: 16px; margin-top: 12px;">
        <a href="https://instagram.com" target="_blank" style="color: #D4B07B;">Instagram</a>
        <a href="https://facebook.com" target="_blank" style="color: #D4B07B;">Facebook</a>
        <a href="https://whatsapp.com" target="_blank" style="color: #D4B07B;">WhatsApp</a>
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h4>Connect With Us</h4>
      <ul>
        <li><a href="https://wa.me/917390802311">WhatsApp Support</a></li>
        <li><a href="/pages/contact">Contact Form</a></li>
        <li><a href="/collections/all">Instagram Shop</a></li>
      </ul>
    </div>

    <!-- Order Support -->
    <div>
      <h4>Order Support</h4>
      <ul>
        <li><a href="/pages/track-order">Track Your Order</a></li>
        <li><a href="/pages/returns">Return / Exchange Policy</a></li>
        <li><a href="/pages/shipping">Shipping Policy</a></li>
        <li><a href="/pages/terms">Terms of Service</a></li>
        <li><a href="/pages/faqs">FAQs</a></li>
      </ul>
    </div>

    <!-- Newsletter -->
    <div>
      <h4>Join Gifty Club</h4>
      <p style="font-size: 14px; color: rgba(245,240,235,0.8); margin-bottom: 16px;">Subscribe to receive exclusive festive discounts, secret voucher codes, and first access.</p>
      <form style="display: flex; flex-direction: column; gap: 10px;">
        <input type="email" placeholder="Enter your email address" style="width: 100%; padding: 12px 16px; border-radius: 9999px; background: #172946; border: 1px solid rgba(212,176,123,0.4); color: #F5F0EB; font-size: 14px;">
        <button type="submit" class="btn-secondary" style="padding: 10px;">Subscribe & Get 10% Off</button>
      </form>
    </div>
  </div>

  <div class="gifty-footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} GIFTY.IN. ALL RIGHTS RESERVED. DESIGNED FOR LUXURY GIFTING ACROSS INDIA.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
