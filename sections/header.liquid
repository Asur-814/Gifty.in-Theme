<header class="gifty-header">
  <div class="gifty-header-container">
    <!-- Mobile Menu Toggle -->
    <button type="button" class="md:hidden text-[#D4B07B] p-2" data-mobile-menu-toggle aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>

    <!-- Brand Logo -->
    <div class="flex items-center space-x-3">
      <a href="{{ routes.root_url }}" class="gifty-logo">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 150 }}" alt="{{ shop.name }}" style="height: 40px; width: auto;">
        {%- else -%}
          <span>{{ section.settings.logo_text | default: "Gifty.in" }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Nav Links -->
    <nav class="gifty-nav hidden md:flex">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <a href="/collections/all">All Gifts</a>
      <a href="/collections/bangles">Bangles</a>
      <a href="/collections/hampers">Gift Hampers</a>
      <a href="/pages/contact">Contact Us</a>
    </nav>

    <!-- Actions (Search, Account, Cart) -->
    <div class="gifty-header-actions">
      <a href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon-search' %}
      </a>
      <a href="{{ routes.account_login_url }}" class="hidden sm:block" aria-label="Account">
        {% render 'icon-account' %}
      </a>
      <a href="{{ routes.cart_url }}" class="relative flex items-center" data-cart-toggle aria-label="Cart">
        {% render 'icon-cart' %}
        <span style="position: absolute; top: -8px; right: -8px; background: #D4B07B; color: #0C1626; font-size: 10px; font-weight: bold; width: 20px; height: 20px; border-radius: 9999px; display: flex; align-items: center; justify-content: center;">
          {{ cart.item_count | default: 2 }}
        </span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Fallback Text",
      "default": "Gifty.in"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable sticky header",
      "default": true
    }
  ]
}
{% endschema %}
