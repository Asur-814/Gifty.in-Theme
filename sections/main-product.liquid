<div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    <!-- Left Column: Gallery -->
    <div class="space-y-4">
      <div class="aspect-square gifty-card overflow-hidden bg-white">
        <img src="{{ product.featured_image | image_url: width: 1000 | default: 'https://images.unsplash.com/photo-1611591475571-124b616b6c4b?w=800&auto=format&fit=crop&q=80' }}" alt="{{ product.title | default: 'Royal Kundan Bangles Set' }}" class="w-full h-full object-cover">
      </div>
      <div class="grid grid-cols-4 gap-4">
        <div class="aspect-square rounded-[12px] overflow-hidden border-2 border-[#D4B07B] cursor-pointer bg-white">
          <img src="https://images.unsplash.com/photo-1611591475571-124b616b6c4b?w=300&auto=format&fit=crop&q=80" alt="Thumbnail" class="w-full h-full object-cover">
        </div>
        <div class="aspect-square rounded-[12px] overflow-hidden border border-gray-200 cursor-pointer bg-white">
          <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=300&auto=format&fit=crop&q=80" alt="Thumbnail" class="w-full h-full object-cover">
        </div>
        <div class="aspect-square rounded-[12px] overflow-hidden border border-gray-200 cursor-pointer bg-white">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=300&auto=format&fit=crop&q=80" alt="Thumbnail" class="w-full h-full object-cover">
        </div>
      </div>
    </div>

    <!-- Right Column: Product Form -->
    <div>
      <span class="gifty-badge mb-3">Dispatch within 24 hours</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#0C1626] mb-3">{{ product.title | default: "Royal Kundan Bangles Set with Premium Velvet Box" }}</h1>
      
      <div class="flex items-center space-x-4 mb-6">
        <span class="text-2xl font-bold text-[#0C1626]">{{ product.price | money_or_fallback: "₹1,499" }}</span>
        <span class="text-gray-400 line-through text-lg">{{ product.compare_at_price | money_or_fallback: "₹2,999" }}</span>
        <span class="bg-red-50 text-red-600 font-semibold px-2.5 py-1 rounded-full text-xs border border-red-200">Save 50%</span>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-[12px] p-4 mb-6 text-sm text-amber-900 flex items-center space-x-3">
        <span class="text-xl">⚡</span>
        <div>
          <span class="font-bold">Fast Dispatch:</span> Order within <span class="underline font-semibold">4 hrs 12 mins</span> for guaranteed dispatch tomorrow.
        </div>
      </div>

      {%- form 'product', product, class: "space-y-6" -%}
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Select Size / Variant</label>
          <div class="flex space-x-3">
            <button type="button" class="px-4 py-2 rounded-lg border-2 border-[#0C1626] font-medium text-sm bg-white text-[#0C1626]">2.4 (Small)</button>
            <button type="button" class="px-4 py-2 rounded-lg border border-gray-300 font-medium text-sm bg-white text-gray-700 hover:border-[#0C1626]">2.6 (Medium)</button>
            <button type="button" class="px-4 py-2 rounded-lg border border-gray-300 font-medium text-sm bg-white text-gray-700 hover:border-[#0C1626]">2.8 (Large)</button>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Quantity</label>
          <div class="flex items-center w-32 border border-gray-300 rounded-lg overflow-hidden bg-white">
            <button type="button" class="px-3 py-2 bg-gray-50 hover:bg-gray-100 text-gray-600">-</button>
            <input type="number" name="quantity" value="1" min="1" class="w-full text-center border-none focus:outline-none py-2 text-sm font-semibold">
            <button type="button" class="px-3 py-2 bg-gray-50 hover:bg-gray-100 text-gray-600">+</button>
          </div>
        </div>

        <div class="space-y-3">
          <button type="submit" name="add" class="w-full btn-primary py-4 text-base">Add to Cart</button>
          <button type="submit" name="buy" class="w-full btn-secondary py-4 text-base">Buy It Now - Express Checkout</button>
        </div>
      {%- endform -%}

      <!-- Accordions -->
      <div class="mt-8 border-t border-[#E5E0D8] divide-y divide-[#E5E0D8]">
        <details class="py-4 group">
          <summary class="font-serif font-bold text-[#0C1626] cursor-pointer flex justify-between items-center list-none">
            <span>Description & Material Care</span>
            <span class="text-[#D4B07B] group-open:rotate-180 transition">&darr;</span>
          </summary>
          <p class="mt-3 text-gray-600 text-sm leading-relaxed">
            Handcrafted with precision 22k micro gold plating, AAA-grade simulated kundan stones, and anti-tarnish protective coating. Comes in our signature Gifty.in velvet gift box.
          </p>
        </details>
        <details class="py-4 group">
          <summary class="font-serif font-bold text-[#0C1626] cursor-pointer flex justify-between items-center list-none">
            <span>Shipping & Delivery Policy</span>
            <span class="text-[#D4B07B] group-open:rotate-180 transition">&darr;</span>
          </summary>
          <p class="mt-3 text-gray-600 text-sm leading-relaxed">
            All orders are shipped via express air couriers. Pan-India delivery takes 2 to 5 business days. Prepaid orders include insured transit.
          </p>
        </details>
        <details class="py-4 group">
          <summary class="font-serif font-bold text-[#0C1626] cursor-pointer flex justify-between items-center list-none">
            <span>Return & Replacement Policy</span>
            <span class="text-[#D4B07B] group-open:rotate-180 transition">&darr;</span>
          </summary>
          <p class="mt-3 text-gray-600 text-sm leading-relaxed">
            Hassle-free 7-day returns for transit damage or defects. An unboxing video is required for all damage claims.
          </p>
        </details>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main product",
  "settings": [],
  "presets": [
    {
      "name": "Main product"
    }
  ]
}
{% endschema %}
