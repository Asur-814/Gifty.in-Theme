<div class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="gifty-badge mb-3">{{ section.settings.badge_text | default: "Trending in India" }}</span>
    <h2 class="text-3xl sm:text-4xl font-serif text-[#0C1626] font-bold">{{ section.settings.title | default: "Our Viral Collection" }}</h2>
    <p class="mt-3 text-gray-600">{{ section.settings.description | default: "Handcrafted luxury gifts and stunning accessories loved by 50,000+ happy customers." }}</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'card-product', product: product %}
      {%- endfor -%}
    {%- else -%}
      <!-- Fallback Demo Cards if no collection selected -->
      {% render 'card-product', demo_title: "Royal Kundan Bangles Set", demo_price: "₹1,499", demo_compare: "₹2,999", demo_image: "https://images.unsplash.com/photo-1611591475571-124b616b6c4b?w=600&auto=format&fit=crop&q=80", demo_badge: "Dispatch within 24h" %}
      {% render 'card-product', demo_title: "Personalized Rose Gold Couple Watch", demo_price: "₹2,299", demo_compare: "₹4,599", demo_image: "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=600&auto=format&fit=crop&q=80", demo_badge: "Best Seller" %}
      {% render 'card-product', demo_title: "Luxury Velvet Gift Hamper Box", demo_price: "₹1,899", demo_compare: "₹3,499", demo_image: "https://images.unsplash.com/photo-1549465220-1a8b9238cd48?w=600&auto=format&fit=crop&q=80", demo_badge: "Free Gift" %}
      {% render 'card-product', demo_title: "Zircon Diamond Solitaire Necklace", demo_price: "₹1,199", demo_compare: "₹2,499", demo_image: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&auto=format&fit=crop&q=80", demo_badge: "Dispatch within 24h" %}
    {%- endif -%}
  </div>

  <div class="text-center mt-12">
    <a href="{{ collection.url | default: '/collections/all' }}" class="btn-primary">{{ section.settings.button_text | default: "View All Collection" }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Trending in India"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Viral Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handcrafted luxury gifts and stunning accessories loved by 50,000+ happy customers."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
